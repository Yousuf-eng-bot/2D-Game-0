/uploads/
/deliverables/
*.sav
!tests/fixtures/*.sav

# Runtime WAVs, cover.bin, fonts, generated ui7_fonts.hpp and synthetic test
# fixtures are source inputs and MUST remain tracked in the GitHub repository.
.DS_Store
Thumbs.db
